# Copie para .env e ajuste se precisar. O Bun carrega o .env automaticamente.

# --- infraestrutura (lido pelo docker compose) ---
POSTGRES_PORT=5432
LOCALSTACK_PORT=4566

# --- aplicacao ---
PORT=3000
APP_INSTANCE_ID=instance-1
DATABASE_URL=postgres://jungle:jungle_password@localhost:5432/wagering_db
PG_POOL_MAX=20

# --- SQS (LocalStack) ---
SQS_ENABLED=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
SQS_QUEUE_TRANSACTIONS=wager-transactions.fifo
SQS_QUEUE_TRANSACTIONS_DLQ=wager-transactions-dlq.fifo
SQS_QUEUE_EVENTS=wager-events.fifo

# --- workers ---
WORKERS_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=200
OUTBOX_BATCH_SIZE=50
PENDING_REFERENCE_POLL_INTERVAL_MS=250
PENDING_REFERENCE_BATCH_SIZE=20
PENDING_REFERENCE_MAX_ATTEMPTS=5
PENDING_REFERENCE_BASE_DELAY_MS=500

LOG_LEVEL=info